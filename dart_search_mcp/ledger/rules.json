      "LEASE_EXEMPTION": "리스|사용권",
      "IP_FAIR_VALUE": "투자부동산",
      "PPA_MEASUREMENT_PERIOD": "사업결합|합병",
      "BUSINESS_COMBINATION_COST_CLASS": "사업결합|합병"

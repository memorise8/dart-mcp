    "dev_expensed_statement": {
      "pattern": "요건을?\\s*(모두\\s*)?충족하지\\s*(못|않|아니)[^.]{0,80}비용",
      "requires": "(하였|했|되었|됐)(습니다|다)|금액|내역|\\d[\\d,]*\\s*(천원|백만원|원)",
      "exclude": "손상|상각"
